[Unit]
Description=Comprobar o aplicar actualizaciones solicitadas desde Servicio de control
After=network-online.target pve-cluster.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /etc/studio-infra/updates/updates.sh --jobs
TimeoutStartSec=30min
UMask=0077
Environment=GIT_TERMINAL_PROMPT=0
