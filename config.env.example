# Red IPv4 del estudio. El cuestionario de ./install.sh genera config.env.
# Para edición manual, copia este ejemplo y usa ./install.sh --from-config.
# Este archivo se carga con Bash: usa solo asignaciones y protégelo con chmod 600.
PROXMOX_IP=192.168.1.10
GATEWAY=192.168.1.1
CIDR=24
BRIDGE=vmbr0
TEMPLATE_STORAGE=local
DISK_STORAGE=local-lvm
BASE_DOMAIN=lan
LANDING_SUBDOMAIN=inicio
# Selección predeterminada. Si se omite, se usan todos los CTs con IP.
# INSTALL_CTS="adguard caddy companion ndi"

ADGUARD_CT_ID=110
ADGUARD_IP=192.168.1.11
ADGUARD_HOSTNAME=adguard
CADDY_CT_ID=111
CADDY_IP=192.168.1.12
CADDY_HOSTNAME=caddy

COMPANION_CT_ID=112
COMPANION_IP=192.168.1.15
COMPANION_HOSTNAME=companion
# Opcional. La encuesta guarda una lista de NIC como JSON por CT.
# La primera IP debe coincidir con COMPANION_IP. gateway y vlan pueden quedar vacíos.
# COMPANION_NICS='[{"bridge":"vmbr0","ip":"192.168.1.15/24","gateway":"192.168.1.1","vlan":""},{"bridge":"vmbr1","ip":"10.20.0.15/24","gateway":"","vlan":"20"}]'
COMPANION_PORT=8000
# stable o una versión estable concreta, por ejemplo 5.0.0. Solo al crear el CT.
COMPANION_BUILD=stable
NDI_CT_ID=113
NDI_IP=192.168.1.16
NDI_HOSTNAME=ndi-discovery
NDI_PORT=5959
# El SDK oficial incluye ndi-discovery-server para Linux x86_64.
# El cuestionario muestra la licencia antes de crear los CTs.
NDI_INSTALLER_URL=https://downloads.ndi.tv/SDK/NDI_SDK_Linux/Install_NDI_SDK_v6_Linux.tar.gz
# Opcional: archivo .tar.gz o .sh oficial ya descargado en el HOST Proxmox.
# Una ruta relativa se resuelve desde la raíz del repositorio.
NDI_INSTALLER_FILE=""
# Opcional: SHA-256 del instalador .tar.gz/.sh, si lo has verificado por otra vía.
NDI_INSTALLER_SHA256=""
# El instalador guarda aquí la huella del texto de la licencia que has aceptado.
NDI_LICENSE_SHA256=""

# DNS independiente de AdGuard para arrancar los CTs e instalar paquetes.
# No apuntar a ninguno de los cuatro CTs ni a un router que reenvíe a AdGuard.
BOOTSTRAP_DNS=1.1.1.1
# Servidores DNS IPv4 separados por espacios; se usan solo al crear AdGuard.
UPSTREAM_DNS="1.1.1.1 9.9.9.9"
TIMEZONE=Europe/Madrid
ADGUARD_ADMIN_USER=admin
# Contraseña aleatoria guardada en .secrets/adguard-admin.json al primer arranque.
# Para los CTs no hace falta contraseña root: usa pct enter <ID> desde el host.
